[Unit]
Description=KOS Quickshell desktop shell
Requires=kos-platform.service
After=graphical-session.target kos-platform.service
Wants=kos-data.service
After=kos-data.service
# KDE marks graphical-session.target active before kwin_wayland has its
# Wayland socket ready. Waiting on the compositor service prevents the
# platform daemon and shell from starting too early and aborting on
# "could not connect to display" (SIGABRT, then a 2s restart loop).
After=plasma-kwin_wayland.service
# DeskCenter shares the desktop with Plasma's wallpaper/file surface. Starting
# after plasmashell keeps their initial stacking deterministic; DeskCenter also
# uses the Bottom layer so later Plasma restarts cannot hide it again.
After=plasma-plasmashell.service
PartOf=graphical-session.target

[Service]
Type=simple
# Detached processes keep the launching cgroup even after fork+setsid. Use
# process mode so restarting the Shell signals only the main qs process and
# leaves applications launched from the Dock alive. mixed is insufficient: it
# sends SIGTERM only to qs first, but then SIGKILLs every remaining cgroup
# process as soon as qs exits.
KillMode=process
# The installed shell must be stable: `sync`/`install` overwrite the config
# directory it watches. Disable the file watcher so a copy in progress can
# never trigger a hot-reload of half-written QML (which crashes quickshell).
# QML edits take effect via `kosctl start`, or via `kosctl dev` (which runs
# from the source tree with its own watcher and sockets).
Environment=QS_DISABLE_FILE_WATCHER=1
# 52 threads let glibc open many malloc arenas; each keeps its own freed
# memory instead of returning it, inflating RSS by ~200MB. Cap the arenas.
Environment=MALLOC_ARENA_MAX=2
# Let Qt choose its render loop for the active platform and graphics backend.
Environment=QML2_IMPORT_PATH=%h/.config/quickshell/kos:%h/.local/lib/qt6/qml
ExecStart=@QS_EXEC@ --no-duplicate -c kos
# Login spinner in its own Quickshell instance: this process cannot run any QML
# until the desktop tree is built, so a spinner started from there would only
# appear at the end of the wait. The Shell stops it when the arrival animation
# starts (StartupSplash.qml); %h matches the QML2_IMPORT_PATH line above.
ExecStartPost=/bin/sh -c '@QS_EXEC@ -n -p %h/.config/quickshell/kos/splash >/dev/null 2>&1 &'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
