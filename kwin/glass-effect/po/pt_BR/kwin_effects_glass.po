#: src/kcm/blur_config.cpp:34
msgid "Glass"
msgstr "Vidro"

#: src/kcm/blur_config.cpp:67
#, kde-format
msgid ""
"<p>Specify one window class per line.</p><p>Use <code>$blank</code> to match "
"empty window classes.<br/>Use <code>$$</code> for literal dollar sign.</p>"
msgstr "<p>Especifique uma classe de janela por linha.</p><p>Use <code>$blank</code> para corresponder a classes de janela vazias.<br/>Use <code>$$</code> para um cifrão literal.</p>"

