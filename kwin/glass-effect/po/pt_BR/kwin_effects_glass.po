#. i18n: ectx: property (toolTip), widget (QLineEdit, kcfg_TintColor)
#: src/kcm/blur_config.ui:340
#, kde-format
msgid ""
"Enter a color in #AARRGGBB format. The A (alpha) channel sets tint strength."
msgstr "Digite uma cor no formato #AARRGGBB. O canal A (alfa) define a intensidade do tingimento."

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_AutoTintAlpha)
#: src/kcm/blur_config.ui:545
#, kde-format
msgid "Automatically adjust tint strength"
msgstr "Ajustar automaticamente a intensidade do tingimento"

#. i18n: ectx: property (toolTip), widget (QCheckBox, kcfg_AutoTintAlpha)
#: src/kcm/blur_config.ui:548
#, kde-format
msgid ""
"Scales tint strength by comparing the average background color with the text "
"color."
msgstr "Ajusta a intensidade do tingimento comparando a cor média do fundo com a cor do texto."

#. i18n: ectx: property (text), widget (QLabel, labelGlowColor)
#: src/kcm/blur_config.ui:351
#, kde-format
