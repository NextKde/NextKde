msgstr "Cor do brilho"

#. i18n: ectx: property (toolTip), widget (QLineEdit, kcfg_GlowColor)
#: src/kcm/blur_config.ui:364
#, kde-format
msgid ""
"Enter a color in #AARRGGBB format. The A (alpha) channel sets glow strength."
msgstr "Digite uma cor no formato #AARRGGBB. O canal A (alfa) define a intensidade do brilho."

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_EdgeLighting)
#: src/kcm/blur_config.ui:380
#, kde-format
msgid "Make the window edges brighter"
msgstr "Deixar as bordas das janelas mais claras"

