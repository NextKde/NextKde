<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
    http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
    <kcfgfile arg="true"/>
    <group name="Effect-blurplus">
        <entry name="ExcludeDecorations" type="Bool">
            <default>false</default>
        </entry>
        <entry name="BlurStrength" type="Int">
            <default>15</default>
        </entry>
        <entry name="BlurFinetune" type="Int">
            <default>3</default>
        </entry>
        <entry name="BlurSaturationCompensation" type="Bool">
            <default>true</default>
        </entry>
        <entry name="NoiseStrength" type="Int">
            <default>5</default>
        </entry>
        <entry name="DecorationBlurStrength" type="Int">
            <default>15</default>
        </entry>
        <entry name="DecorationNoiseStrength" type="Int">
            <default>5</default>
        </entry>
        <entry name="DockBlurStrength" type="Int">
            <default>15</default>
        </entry>
        <entry name="DockNoiseStrength" type="Int">
            <default>5</default>
        </entry>
        <entry name="BlurDecorations" type="Bool">
            <default>false</default>
        </entry>
        <entry name="OnlyQuickshell" type="Bool">
            <default>true</default>
        </entry>
        <entry name="WindowClasses" type="String">
            <default>quickshell</default>
        </entry>
        <entry name="BlurMatching" type="Bool">
            <default>true</default>
        </entry>
        <entry name="BlurNonMatching" type="Bool">
            <default>false</default>
        </entry>
        <entry name="TransparentBlur" type="Bool">
            <default>true</default>
        </entry>
        <entry name="MenuCornerRadius" type="Double">
            <default>0.0</default>
        </entry>
        <entry name="DockCornerRadius" type="Double">
            <default>0.0</default>
        </entry>
        <entry name="CornerExponent" type="Double">
            <default>3.0</default>
            <whatsthis>Global Quickshell glass corner profile. 2.0 is circular; larger values produce continuous superellipse corners.</whatsthis>
        </entry>
        <entry name="ShapeTrace" type="Bool">
            <default>false</default>
            <whatsthis>Log every kos-surface-shape-v1 draw decision at debug level in the kwin_effect_blur category (enable with QT_LOGGING_RULES=kwin_effect_blur.debug=true). KOS_GLASS_TRACE overrides this setting when it is an integer: 0 disables tracing and nonzero enables it; unset or invalid values use this setting. Environment changes require restarting the compositor.</whatsthis>
        </entry>
        <entry name="UseDeclaredCornerRadius" type="Bool">
            <default>false</default>
        </entry>
        <entry name="IgnoreContentBlurRegion" type="Bool">
            <default>false</default>
        </entry>
        <entry name="DynamicCorners" type="Bool">
            <default>false</default>
        </entry>
        <entry name="DynamicCornersExcludeDocks" type="Bool">
            <default>false</default>
        </entry>
        <entry name="DynamicCornersExcludeTooltips" type="Bool">
            <default>false</default>
        </entry>
        <entry name="DynamicCornersExcludeMenus" type="Bool">
            <default>false</default>
        </entry>
        <entry name="BlurMenus" type="Bool">
            <default>false</default>
        </entry>
        <entry name="BlurDocks" type="Bool">
            <default>false</default>
        </entry>
        <entry name="SkipEmptyDockBlurRegions" type="Bool">
            <default>true</default>
        </entry>
        <entry name="FakeBlur" type="Bool">
            <default>false</default>
        </entry>
        <entry name="FakeBlurImage" type="String">
            <default></default>
        </entry>
        <entry name="FakeBlurImageSourceDesktopWallpaper" type="Bool">
            <default>true</default>
        </entry>
        <entry name="FakeBlurImageSourceCustom" type="Bool">
            <default>false</default>
        </entry>
        <entry name="FakeBlurCustomImageBlur" type="Bool">
            <default>true</default>
        </entry>
        <entry name="FakeBlurDisableWhenWindowBehind" type="Bool">
            <default>true</default>
        </entry>
        <entry name="Saturation" type="Double">
            <default>1.0</default>
        </entry>
        <entry name="OklabSaturation" type="Bool">
            <default>false</default>
        </entry>
        <entry name="Brightness" type="Double">
            <default>1.0</default>
        </entry>
        <entry name="Contrast" type="Double">
            <default>1.0</default>
        </entry>
        <entry name="RefractionNormalPow" type="Double">
            <default>2.0</default>
        </entry>
        <entry name="RefractionStrength" type="Double">
            <default>0.0</default>
        </entry>
        <entry name="RefractionEdgeSize" type="Double">
            <default>20.0</default>
        </entry>
        <entry name="RefractionRGBFringing" type="Double">
            <default>1.0</default>
        </entry>
        <entry name="RefractionOffsetStrength" type="Double">
            <default>0.0</default>
        </entry>
        <entry name="MaterialSoftness" type="Double">
            <default>0.0</default>
            <whatsthis>Shared material softness from 0.0 (clear liquid glass) to 1.0 (diffuse soft glass).</whatsthis>
        </entry>
        <entry name="MaterialReflectionStrength" type="Double">
            <default>0.0</default>
            <whatsthis>Strength of the broad directional soft-glass reflection.</whatsthis>
        </entry>
    </group>
</kcfg>
