{
  "version": 2,
  "revision": 1,
  "enabled": true,
  "defaults": {
    "corners": { "radius": 20, "profile": "continuous", "smoothness": 0.6 },
    "frame": { "mode": "none", "smallWidth": 4, "thickWidth": 10 },
    "content": { "mode": "compact" },
    "fill": { "mode": "theme" },
    "outline": {
      "width": 1,
      "widthUnit": "physical",
      "appearance": "auto",
      "colorMode": "fixed",
      "color": "#FFE0E0E0",
      "light": "#FF000000",
      "dark": "#FFFFFFFF",
      "activeOpacity": 0.16,
      "inactiveOpacity": 0.08
    },
    "shadow": {
      "enabled": true,
      "dynamic": true,
      "strength": 0.37,
      "minimumStrength": 0.08,
      "depthDecay": 0.7,
      "transitionMs": 180,
      "contactBlur": 1,
      "activeBlur": 14,
      "inactiveBlur": 8,
      "contactOpacity": 0.22,
      "ambientOpacity": 0.28
    },
    "states": { "fullscreen": "off", "maximized": "inherit", "tiled": "inherit" }
  },
  "apps": {
    "org.kde.kate": {
      "outline": { "appearance": "dark" }
    }
  }
}
