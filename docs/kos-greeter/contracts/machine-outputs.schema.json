{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "outputs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hardwareId",
          "connector",
          "mode",
          "scale",
          "rotation",
          "position",
          "priority",
          "hdr",
          "vrr"
        ],
        "properties": {
          "hardwareId": {
            "type": "string",
            "pattern": "^edid-sha256:[0-9a-f]{64}$"
          },
          "connector": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "mode": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height",
              "refreshHz"
            ],
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "refreshHz": {
                "type": "number",
                "minimum": 1,
                "maximum": 1000
              }
            }
          },
          "scale": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 4
          },
          "rotation": {
            "type": "integer",
            "enum": [
              0,
              90,
              180,
              270
            ]
          },
          "position": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": -64000,
              "maximum": 64000
            }
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "hdr": {
            "type": "boolean",
            "const": false
          },
          "vrr": {
            "type": "string",
            "const": "never"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KOS machine output policy v1"
}
