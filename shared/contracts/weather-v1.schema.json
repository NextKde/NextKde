{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SuceV587/NextKde/shared/contracts/weather-v1.schema.json",
  "title": "NextKde weather snapshot v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "provider",
    "status",
    "units",
    "location",
    "locations",
    "hourly",
    "daily"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provider": { "const": "open-meteo" },
    "status": { "enum": ["idle", "loading", "ready", "error"] },
    "units": { "enum": ["metric", "imperial"] },
    "location": { "oneOf": [
      { "$ref": "#/$defs/location" },
      { "$ref": "#/$defs/emptyLocation" }
    ] },
    "locations": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/location" }
    },
    "fetchedAt": { "type": "integer", "minimum": 0 },
    "nextRefreshAt": { "type": "integer", "minimum": 0 },
    "staleAt": { "type": "integer", "minimum": 0 },
    "lastAttemptAt": { "type": "integer", "minimum": 0 },
    "error": { "type": "string", "maxLength": 240 },
    "current": { "$ref": "#/$defs/current" },
    "airQuality": { "$ref": "#/$defs/airQuality" },
    "hourly": {
      "type": "array",
      "maxItems": 48,
      "items": { "$ref": "#/$defs/hourlyPoint" }
    },
    "daily": {
      "type": "array",
      "maxItems": 7,
      "items": { "$ref": "#/$defs/day" }
    }
  },
  "additionalProperties": true,
  "allOf": [{
    "if": { "properties": { "locations": { "maxItems": 0 } } },
    "then": {
      "properties": {
        "location": { "$ref": "#/$defs/emptyLocation" },
        "status": { "const": "idle" },
        "hourly": { "maxItems": 0 },
        "daily": { "maxItems": 0 }
      },
      "not": { "required": ["current"] }
    },
    "else": { "properties": { "location": { "$ref": "#/$defs/location" } } }
  }],
  "$defs": {
    "emptyLocation": {
      "type": "object",
      "required": ["id", "name", "latitude", "longitude"],
      "properties": {
        "id": { "const": "" }, "name": { "const": "" },
        "latitude": { "const": 0 }, "longitude": { "const": 0 }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": ["id", "name", "latitude", "longitude"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "admin1": { "type": "string" },
        "country": { "type": "string" },
        "countryCode": { "type": "string" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "timezone": { "type": "string" },
        "summary": {
          "type": "object",
          "properties": {
            "time": { "type": "string" },
            "temperature": { "type": "number" },
            "weatherCode": { "type": "integer" },
            "isDay": { "type": "boolean" },
            "tempHigh": { "type": "number" },
            "tempLow": { "type": "number" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "current": {
      "type": "object",
      "required": [
        "time",
        "temperature",
        "apparentTemperature",
        "relativeHumidity",
        "isDay",
        "weatherCode",
        "windSpeed",
        "windDirection"
      ],
      "properties": {
        "time": { "type": "string" },
        "temperature": { "type": "number" },
        "apparentTemperature": { "type": "number" },
        "relativeHumidity": { "type": "number", "minimum": 0, "maximum": 100 },
        "isDay": { "type": "boolean" },
        "weatherCode": { "type": "integer" },
        "windSpeed": { "type": "number", "minimum": 0 },
        "windDirection": { "type": "number", "minimum": 0, "maximum": 360 },
        "windGust": { "type": ["number", "null"], "minimum": 0 },
        "uvIndex": { "type": ["number", "null"], "minimum": 0 },
        "visibility": { "type": ["number", "null"], "minimum": 0 },
        "pressure": { "type": ["number", "null"], "minimum": 0 },
        "moonPhase": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "moonIllumination": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": true
    },
    "airQuality": {
      "type": "object",
      "required": ["time"],
      "properties": {
        "time": { "type": "string" },
        "usAqi": { "type": ["number", "null"], "minimum": 0 },
        "category": { "type": "string" }
      },
      "additionalProperties": true
    },
    "hourlyPoint": {
      "type": "object",
      "required": [
        "time",
        "temperature",
        "apparentTemperature",
        "relativeHumidity",
        "precipitationProbability",
        "weatherCode",
        "isDay",
        "windSpeed"
      ],
      "properties": {
        "time": { "type": "string" },
        "temperature": { "type": "number" },
        "apparentTemperature": { "type": "number" },
        "relativeHumidity": { "type": "number" },
        "precipitationProbability": { "type": "number" },
        "weatherCode": { "type": "integer" },
        "isDay": { "type": "boolean" },
        "windSpeed": { "type": "number" }
      },
      "additionalProperties": true
    },
    "day": {
      "type": "object",
      "required": [
        "date",
        "weatherCode",
        "temperatureMaximum",
        "temperatureMinimum",
        "precipitationProbability"
      ],
      "properties": {
        "date": { "type": "string" },
        "weatherCode": { "type": "integer" },
        "temperatureMaximum": { "type": "number" },
        "temperatureMinimum": { "type": "number" },
        "precipitationProbability": { "type": "number" },
        "sunrise": { "type": "string" },
        "sunset": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
