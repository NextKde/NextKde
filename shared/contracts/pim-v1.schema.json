{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SuceV587/NextKde/shared/contracts/pim-v1.schema.json",
  "title": "NextKde local PIM snapshot v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "generatedAt",
    "writable",
    "error",
    "lists",
    "events",
    "todos"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "generatedAt": { "type": "integer", "minimum": 0 },
    "writable": { "type": "boolean" },
    "error": { "type": "string" },
    "calendars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "color"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "builtinName": { "type": "boolean" },
          "customColor": { "type": "boolean" }
        }
      }
    },
    "holidaySources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "url", "provider"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "url": { "type": "string" },
          "provider": { "type": "string" }
        }
      }
    },
    "holidayCalendars": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "enabled", "color"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "type": { "enum": ["country", "url", "file"] },
          "enabled": { "type": "boolean" },
          "color": { "type": "string" },
          "lastUpdated": { "type": "number", "minimum": 0 },
          "lastAttempt": { "type": "number", "minimum": 0 },
          "lastError": { "type": "string" },
          "eventCount": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/namedOrganization" } },
    "lists": {
      "type": "array",
      "items": { "$ref": "#/$defs/list" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "todos": {
      "type": "array",
      "items": { "$ref": "#/$defs/todo" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "namedOrganization": {
      "type": "object", "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "recurrence": {
      "enum": ["none", "daily", "weekly", "monthly", "yearly", "custom"]
    },
    "list": {
      "type": "object",
      "required": ["id", "name", "color", "position"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "color": { "type": "string" },
        "position": { "type": "integer", "minimum": 0 },
        "group": { "type": "string", "maxLength": 128 },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/namedOrganization" } },
        "viewMode": { "enum": ["list", "columns"], "default": "list" },
        "icon": { "type": "string" },
        "kind": { "enum": ["list", "smart"], "default": "list" },
        "rules": {
          "type": "object",
          "properties": {
            "listId": { "type": "string", "maxLength": 128 },
            "tag": { "type": "string", "maxLength": 128 },
            "date": { "enum": ["any", "today", "scheduled", "undated", "overdue"] },
            "flag": { "enum": ["any", "yes", "no"] },
            "priority": { "enum": ["any", "high", "medium", "low", "none"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "seriesId",
        "title",
        "description",
        "location",
        "start",
        "end",
        "allDay",
        "timeZone",
        "calendarId",
        "recurrence",
        "recurrenceId",
        "reminderMinutes",
        "modifiedAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "seriesId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "description": { "type": "string", "maxLength": 32768 },
        "location": { "type": "string", "maxLength": 1024 },
        "start": { "type": "string", "minLength": 1 },
        "end": { "type": "string", "minLength": 1 },
        "allDay": { "type": "boolean" },
        "timeZone": { "type": "string" },
        "calendarId": { "type": "string", "minLength": 1 },
        "recurrence": { "$ref": "#/$defs/recurrence" },
        "recurrenceId": { "type": "string" },
        "reminderMinutes": { "type": "integer", "minimum": -1 },
        "linkedTodoId": { "type": "string" },
        "linkedTodoCompleted": { "type": "boolean" },
        "linkedTodoListId": { "type": "string" },
        "linkedTodoPriority": { "type": "integer", "minimum": 0, "maximum": 9 },
        "modifiedAt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "todo": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "listId",
        "parentId",
        "order",
        "start",
        "due",
        "allDay",
        "priority",
        "completed",
        "completedAt",
        "recurrence",
        "reminderMinutes",
        "modifiedAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "description": { "type": "string", "maxLength": 32768 },
        "listId": { "type": "string", "minLength": 1 },
        "parentId": { "type": "string" },
        "flagged": { "type": "boolean", "default": false },
        "url": { "type": "string", "maxLength": 4096 },
        "images": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
        "section": { "type": "string", "maxLength": 128 },
        "tags": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "order": { "type": "number" },
        "start": { "type": "string" },
        "due": { "type": "string" },
        "allDay": { "type": "boolean" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 9 },
        "completed": { "type": "boolean" },
        "completedAt": { "type": "string" },
        "recurrence": { "$ref": "#/$defs/recurrence" },
        "reminderMinutes": { "type": "integer", "minimum": -1 },
        "linkedEventId": { "type": "string" },
        "modifiedAt": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
