  "category": "clock",
  "categoryName": "Clock",
  "i18n": {
    "en": {
      "name": "Clock",
      "description": "1×1 analog and digital clocks for desktop and Dock.",
      "categoryName": "Clock"
    },
    "zh-CN": {
      "name": "时钟",
      "description": "1×1 指针与数字时钟，支持桌面与 Dock。",
      "categoryName": "时钟"
    }
  },
  "version": "0.2.0",
