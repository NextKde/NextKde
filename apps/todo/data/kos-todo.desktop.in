[Desktop Entry]
Version=1.0
Type=Application
NoDisplay=true
X-NextKDE-UnifiedCalendar=true
Name=KOS Todo
Name[zh]=KOS 待办事项
Name[zh_CN]=KOS 待办事项
Name[pt]=KOS Tarefas
Name[pt_BR]=KOS Tarefas
GenericName=Task Manager
GenericName[zh]=任务管理器
GenericName[zh_CN]=任务管理器
GenericName[pt]=Gerenciador de tarefas
GenericName[pt_BR]=Gerenciador de tarefas
Comment=Organize tasks, lists, due dates, and calendar links
Comment[zh]=管理任务、清单、截止时间与日历联动
Comment[zh_CN]=管理任务、清单、截止时间与日历联动
Comment[pt]=Organize tarefas, listas, prazos e vínculos com o calendário
Comment[pt_BR]=Organize tarefas, listas, prazos e vínculos com o calendário
TryExec=@KOS_APP_EXECUTABLE@
Exec=@KOS_APP_EXECUTABLE@
Icon=kos-calendar
Terminal=false
Categories=Office;ProjectManagement;Qt;
Keywords=todo;task;reminder;list;
Keywords[pt]=tarefa;afazer;lembrete;lista;
Keywords[pt_BR]=tarefa;afazer;lembrete;lista;
StartupNotify=true
StartupWMClass=kos-calendar
X-GNOME-SingleWindow=true
Actions=Today;Planned;Settings;

[Desktop Action Today]
Name=Today
Name[zh]=今天
Name[zh_CN]=今天
Name[pt]=Hoje
Name[pt_BR]=Hoje
Exec=@KOS_APP_EXECUTABLE@ --view today

[Desktop Action Planned]
Name=Planned
Name[zh]=计划
Name[zh_CN]=计划
Name[pt]=Planejadas
Name[pt_BR]=Planejadas
Exec=@KOS_APP_EXECUTABLE@ --view planned

[Desktop Action Settings]
Name=Settings
Name[zh]=设置
Name[zh_CN]=设置
Name[pt]=Configurações
Name[pt_BR]=Configurações
Exec=@KOS_APP_EXECUTABLE@ --settings
