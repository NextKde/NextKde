+
+void session_cancel_greeter_handoff(Session *s, bool restore) {
+        assert(s);
+        if (s->manager->greeter_handoff_source != s)
+                return;
+
+        s->manager->greeter_handoff_source = NULL;
+        s->greeter_handoff_timeout = sd_event_source_unref(s->greeter_handoff_timeout);
+        s->greeter_handoff_target_source = sd_event_source_unref(s->greeter_handoff_target_source);
+        pidref_done(&s->greeter_handoff_target);
+        s->greeter_handoff_deadline = 0;
+        /* A cancelled attempt may be retried only while the original greeter still owns the VT. */
+        if (s->controller && session_is_active(s) && !s->stopping)
+                s->greeter_handoff_used = false;
+
+        bool recovered = s->controller != NULL;
+        /* Never reset a controller which has already acquired the same VT. */
+        LIST_FOREACH(sessions_by_seat, other, s->seat->sessions)
+                if (other != s && other->vtnr == s->vtnr && other->controller) {
+                        s->vtfd = safe_close(s->vtfd);
