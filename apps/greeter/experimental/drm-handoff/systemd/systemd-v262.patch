+bool session_greeter_handoff_prepared(Session *s) {
+        assert(s);
+        return s->manager->greeter_handoff_source == s &&
+               s->greeter_handoff_timeout &&
+               now(CLOCK_MONOTONIC) < s->greeter_handoff_deadline &&
+               pidref_is_alive(&s->greeter_handoff_target) > 0;
