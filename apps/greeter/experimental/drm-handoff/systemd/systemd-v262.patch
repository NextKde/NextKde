+        fail_restore = true;
+        session_cancel_greeter_handoff(s, true);
+        assert_se(!m.greeter_handoff_source && s->vtfd < 0);
+        assert_se(access("/run/systemd/greeter-handoff", F_OK) == 0);
+        source_free(s);
+        s = source_new(&m, &seat);
+        assert_se(session_prepare_greeter_handoff(s, target) == -EBUSY);
+        source_free(s);
+        fail_restore = false;
+        assert_se(manager_recover_greeter_handoff(&m) == 0);
+        assert_se(access("/run/systemd/greeter-handoff", F_OK) < 0);
+        kill(target, SIGKILL); assert_se(waitpid(target, NULL, 0) == target);
+        puts("PASS cancellation restore failure preserves recovery marker through session GC");
+
+        target = target_new();
+        int ready[2]; assert_se(pipe(ready) == 0);
+        pid_t daemon = fork(); assert_se(daemon >= 0);
+        if (daemon == 0) {
+                close(ready[0]);
+                sd_event *child_event; assert_se(sd_event_new(&child_event) == 0);
+                m.event = child_event;
+                Session *crashed = source_new(&m, &seat);
+                assert_se(session_prepare_greeter_handoff(crashed, target) == 0);
+                assert_se(write(ready[1], "R", 1) == 1);
+                for (;;) pause();
+        }
+        close(ready[1]); char signal;
+        assert_se(read(ready[0], &signal, 1) == 1); close(ready[0]);
+        assert_se(kill(daemon, SIGKILL) == 0);
+        assert_se(waitpid(daemon, NULL, 0) == daemon);
+        assert_se(access("/run/systemd/greeter-handoff", F_OK) == 0);
+        assert_se(kill(target, SIGKILL) == 0); assert_se(waitpid(target, NULL, 0) == target);
+        FILE *marker;
+        before = restores;
+        fail_restore = true;
+        assert_se(manager_recover_greeter_handoff(&m) == -EIO);
+        assert_se(access("/run/systemd/greeter-handoff", F_OK) == 0);
+        fail_restore = false;
+        assert_se(manager_recover_greeter_handoff(&m) == 0);
+        assert_se(restores == before + 2);
+        assert_se(access("/run/systemd/greeter-handoff", F_OK) < 0);
+        assert_se(manager_recover_greeter_handoff(&m) == 0);
+        puts("PASS crash marker recovery, failed-recovery retry, idempotence");
+        s = source_new(&m, &seat);
+        marker = fopen("/run/systemd/greeter-handoff", "w");
+        assert_se(marker); fputs("1\n", marker); assert_se(fclose(marker) == 0);
+        before = restores;
+        assert_se(manager_recover_greeter_handoff(&m) == 0);
+        assert_se(restores == before);
+        source_free(s);
+        puts("PASS crash recovery preserves live same-VT controller");
+        return 0;
+}
