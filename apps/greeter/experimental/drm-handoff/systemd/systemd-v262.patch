+int manager_recover_greeter_handoff(Manager *m) {
+        _cleanup_free_ char *value = NULL;
+        _cleanup_close_ int fd = -EBADF;
+        Session *other;
+        unsigned vtnr;
+        int r = read_one_line_file(GREETER_HANDOFF_MARKER, &value);
+        if (r == -ENOENT)
+                return 0;
+        if (r < 0)
+                return r;
