+mod handoff_tests {
+    use super::*;
+    fn fixture(message: SessionChildToParent) -> Session {
+        let (parent, peer) = UnixDatagram::pair().unwrap();
+        parent.set_nonblocking(true).unwrap();
+        peer.send(&serde_json::to_vec(&message).unwrap()).unwrap();
+        Session { task: Pid::from_raw(2), sock: TokioUnixDatagram::from_std(parent).unwrap(),
+                  last_msg: None, authenticated_uid: None }
+    }
+    #[tokio::test]
+    async fn ordinary_success_is_not_authentication_authority() {
+        let mut session = fixture(SessionChildToParent::Success);
+        assert!(session.get_state().await.is_err());
+        assert_eq!(session.authenticated_uid(), None);
+    }
+    #[tokio::test]
+    async fn failed_worker_never_authorizes_display_handoff() {
+        let mut session = fixture(SessionChildToParent::Error("fixture-auth-error".into()));
+        assert!(session.get_state().await.is_err());
+        assert_eq!(session.authenticated_uid(), None);
+    }
+    #[tokio::test]
+    async fn authenticated_worker_identity_is_preserved_on_ready_recheck() {
+        let mut session = fixture(SessionChildToParent::AuthenticatedUser { uid: 1234 });
+        assert!(matches!(session.get_state().await.unwrap(), SessionState::Ready));
+        assert_eq!(session.authenticated_uid(), Some(1234));
+        assert!(matches!(session.get_state().await.unwrap(), SessionState::Ready));
+        assert_eq!(session.authenticated_uid(), Some(1234));
+    }
+    #[tokio::test]
+    async fn awaiting_prompt_has_no_authenticated_identity() {
+        let mut session = fixture(SessionChildToParent::PamMessage { style: AuthMessageType::Secret, msg: "fixture".into() });
+        assert!(matches!(session.get_state().await.unwrap(), SessionState::Question(..)));
+        assert_eq!(session.authenticated_uid(), None);
+    }
