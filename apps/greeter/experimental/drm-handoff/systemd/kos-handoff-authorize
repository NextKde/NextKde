#!/usr/bin/python3 -I
"""Experimental root greetd hook. No credential or environment logging."""
import array
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import socket
import stat
import struct
import subprocess
import sys
import time

APP = Path('/usr/local/lib/kos-greeter/app')
PUBLIC = Path('/var/lib/kos/greeter/display')
GREETD = Path('/opt/kos-handoff/bin/greetd')
BUSCTL = '/usr/bin/busctl'
MAX_BYTES = 16 * 1024 * 1024


def trusted_path(path, directory=False):
    path = Path(path)
    for p in [path, *path.parents]:
        info = p.lstat()
        if info.st_uid != 0 or info.st_mode & 0o022 or stat.S_ISLNK(info.st_mode):
            raise ValueError('untrusted-path')
    info = path.lstat()
    if directory and not stat.S_ISDIR(info.st_mode):
        raise ValueError('not-directory')
    if not directory and not stat.S_ISREG(info.st_mode):
        raise ValueError('not-file')


def call(path, method, signature=None, args=()):
    command = [BUSCTL, '--system', '--timeout=1s', '--allow-interactive-authorization=no',
               '--json=short', 'call', 'org.freedesktop.login1', path]
    command += ['org.freedesktop.login1.Manager' if path == '/org/freedesktop/login1'
                else 'org.freedesktop.login1.Session', method]
    if signature:
        command += [signature, *map(str, args)]
    result = subprocess.run(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL, timeout=1.3, check=True,
                            env={'PATH': '/usr/bin:/bin'}, close_fds=True)
    if len(result.stdout) > 4096:
        raise ValueError('oversized-bus-reply')
    return json.loads(result.stdout) if result.stdout.strip() else None


def source_session(pid):
    reply = call('/org/freedesktop/login1', 'GetSessionByPID', 'u', (pid,))
    if not isinstance(reply, dict) or reply.get('type') != 'o' or len(reply.get('data', [])) != 1:
        raise ValueError('invalid-session-reply')
    path = reply['data'][0]
    if not isinstance(path, str) or not re.fullmatch(r'/org/freedesktop/login1/session/[A-Za-z0-9_]{1,128}', path):
        raise ValueError('invalid-session-path')
    return path


def publication(uid):
    """Use the existing live consent/schema/image validator, then verify the actual FD again."""
    trusted_path(APP / 'companion', directory=True)
    for module in ('resources.py', 'wallpaper.py'):
        trusted_path(APP / 'companion' / module)
    if str(APP / 'companion') not in sys.path:
        sys.path.insert(0, str(APP / 'companion'))
    from wallpaper import Reader
    installed = APP / 'public-display'
    public = installed if os.path.lexists(installed) else PUBLIC
    trusted_path(public, directory=True)
    result = Reader(public, 0).consume(uid)
    if not result:
        return None
    manifest, images = result
    if manifest['fit'] not in ('crop', 'fit') or manifest['expiresAt'] < time.time() + 30:
        return None
    path = public / str(uid) / manifest['version'] / 'wallpaper.png'
    trusted_path(path)
    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022 or info.st_nlink != 1 or not 0 < info.st_size <= MAX_BYTES:
            raise ValueError('untrusted-image-fd')
        data = os.pread(fd, MAX_BYTES + 1, 0)
        digest = hashlib.sha256(data).hexdigest()
        if digest != manifest['resources']['wallpaper']['sha256'] or data != images['wallpaper']:
            raise ValueError('changed-image')
        current = Reader(public, 0).manifest(uid)
        if not current or current['version'] != manifest['version'] or current['fit'] != manifest['fit'] or current['resources']['wallpaper']['sha256'] != digest:
            raise ValueError('changed-publication')
        return fd, 'cover' if manifest['fit'] == 'crop' else 'contain'
    except BaseException:
        os.close(fd)
        raise


def arm(channel, uid, nonce):
    try:
        selected = publication(uid)
    except (OSError, ValueError, TypeError, KeyError, ImportError):
        selected = None
    if selected:
        fd, fit = selected
        try:
            payload = f'ARM:{fit}:{uid}:{nonce}'.encode('ascii')
            channel.sendmsg([payload], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array('i', [fd]))])
        finally:
            os.close(fd)
    else:
        channel.send(f'ARM:default:{nonce}'.encode('ascii'))
    deadline = time.monotonic() + 2.5
    while time.monotonic() < deadline:
        channel.settimeout(max(.001, deadline - time.monotonic()))
        response = channel.recv(128)
        if response == f'PRESENTED:{nonce}'.encode('ascii'):
            return
        if response in (b'', f'TIMEOUT:{nonce}'.encode('ascii')):
            raise ValueError('background-not-presented')
        # Stale confirmations never authorize the current transaction.
    raise TimeoutError('background-deadline')


def prepare_and_confirm(channel, path, successor, nonce):
    call(path, 'PrepareGreeterHandoff', 'u', (successor,))
    try:
        channel.settimeout(.5)
        channel.send(f'CONFIRM:{nonce}'.encode('ascii'))
        if channel.recv(128) != f'READY:{nonce}'.encode('ascii'):
            raise ValueError('handoff-expired-before-launch')
    except BaseException:
        # Cancel even if the KWin lease expired while logind was preparing.
        call(path, 'CancelGreeterHandoff')
        raise


def main(argv):
    if os.geteuid() != 0 or len(argv) not in (4, 3):
        return 70
    cancel = argv[0] == 'cancel'
    values = argv[1:] if cancel else argv
    if any(not re.fullmatch(r'[0-9]{1,10}', v) for v in values):
        return 70
    if cancel and len(values) != 2:
        return 70
    if not cancel and len(values) != 4:
        return 70
    numbers = list(map(int, values))
    old, fd = (numbers[0], numbers[-1])
    if not 1 < old <= 2**31 - 1 or not 2 < fd <= 2**31 - 1:
        return 70
    trusted_path(GREETD)
    parent = os.getppid()
    if os.readlink(f'/proc/{parent}/exe') != str(GREETD):
        return 70
    channel = socket.socket(fileno=os.dup(fd))
    with channel:
        if channel.getsockopt(socket.SOL_SOCKET, socket.SO_TYPE) != socket.SOCK_SEQPACKET:
            return 70
        peer, uid, _ = struct.unpack('3i', channel.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        if uid != 0 or peer != parent:
            return 70
        path = source_session(old)
        if cancel:
            call(path, 'CancelGreeterHandoff')
            return 0
        successor, selected_uid = numbers[1:3]
        if not 1 < successor <= 2**31 - 1 or not 0 <= selected_uid < 2**32 - 1 or successor == old:
            return 70
        nonce = secrets.token_hex(16)
        arm(channel, selected_uid, nonce)
        prepare_and_confirm(channel, path, successor, nonce)
        print(path, flush=True)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError, TypeError, KeyError, TimeoutError, subprocess.SubprocessError):
        sys.exit(70)
