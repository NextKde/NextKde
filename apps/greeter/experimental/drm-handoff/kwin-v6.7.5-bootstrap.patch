+namespace KosBootstrapPublication {
+struct Fd {
+    int value = -1;
+    explicit Fd(int fd = -1) : value(fd) {}
+    ~Fd() { if (value >= 0) close(value); }
+    Fd(const Fd &) = delete;
+    Fd &operator=(const Fd &) = delete;
+};
+struct Result {
+    int fd = -1; // Ownership transfers to caller.
+    QString version;
+    QString digest;
+    QString fit;
+    QSize size;
+};
+inline bool trusted(int fd, bool directory, qint64 limit = 0)
+{
+    struct stat st{};
+    return fd >= 0 && fstat(fd, &st) == 0 && st.st_uid == 0 && !(st.st_mode & 0022)
+        && (directory ? S_ISDIR(st.st_mode) : (S_ISREG(st.st_mode) && st.st_nlink == 1 && st.st_size > 0 && st.st_size <= limit));
+}
+inline QByteArray boundedRead(int fd, qint64 limit)
+{
+    QFile input;
+    if (!input.open(fd, QIODevice::ReadOnly, QFileDevice::DontCloseHandle)) return {};
+    const QByteArray data = input.read(limit + 1);
+    return data.size() <= limit ? data : QByteArray{};
+}
+inline bool exactKeys(const QJsonObject &object, QStringList keys)
+{
+    auto actual = object.keys();
+    actual.sort(); keys.sort();
+    return actual == keys;
+}
+inline bool integer(const QJsonValue &value, qint64 &out)
+{
+    if (!value.isDouble()) return false;
+    const double number = value.toDouble();
+    if (!std::isfinite(number) || number < 0 || number > 9007199254740991.0 || std::floor(number) != number) return false;
+    out = qint64(number);
+    return true;
+}
+inline Result openForUid(uid_t uid, bool verifyBytes, qint64 minimumLifetime)
+{
+    Result rejected;
+    Fd root(open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC));
+    if (!trusted(root.value, true)) return rejected;
+    struct stat installed{};
+    const int installedStatus = lstat("/usr/local/lib/kos-greeter/app/public-display", &installed);
+    const bool installedRoot = installedStatus == 0;
+    if (installedStatus != 0 && errno != ENOENT) return rejected;
+    // An existing but untrusted/missing-account installed publication never falls back.
+    QStringList parts = installedRoot
+        ? QStringList{"usr", "local", "lib", "kos-greeter", "app", "public-display"}
+        : QStringList{"var", "lib", "kos", "greeter", "display"};
+    parts.append(QString::number(uid));
+    for (const auto &part : parts) {
+        const int next = openat(root.value, part.toUtf8().constData(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+        if (!trusted(next, true)) { if (next >= 0) close(next); return rejected; }
+        close(root.value); root.value = next;
+    }
+    Fd manifest(openat(root.value, "manifest.json", O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC));
+    if (!trusted(manifest.value, false, 4096)) return rejected;
+    QJsonParseError error{};
+    const auto document = QJsonDocument::fromJson(boundedRead(manifest.value, 4096), &error);
+    if (error.error != QJsonParseError::NoError || !document.isObject()) return rejected;
+    const auto object = document.object();
+    if (!exactKeys(object, {"schemaVersion", "uid", "version", "issuedAt", "expiresAt", "mode", "fit", "crop", "resources"})) return rejected;
+    qint64 schema, manifestUid, issued, expires;
+    const qint64 now = QDateTime::currentSecsSinceEpoch();
+    if (!integer(object["schemaVersion"], schema) || schema != 1 || !integer(object["uid"], manifestUid) || manifestUid != uid
+        || !integer(object["issuedAt"], issued) || !integer(object["expiresAt"], expires)
+        || issued > now || expires <= now || expires > issued + 604800 || expires - now < minimumLifetime) return rejected;
+    const QString version = object["version"].toString();
+    if (!QRegularExpression(QStringLiteral("\\Av-[0-9a-f]{32}\\z")).match(version).hasMatch() || object["mode"].toString() != "image") return rejected;
+    const QString fit = object["fit"].toString();
+    if (fit != "crop" && fit != "fit") return rejected; // stretch/center deliberately fall back.
+    const auto crop = object["crop"].toArray();
+    if (!object["crop"].isArray() || crop.size() != 4) return rejected;
+    for (int i = 0; i < 4; ++i) { qint64 value; if (!integer(crop[i], value) || value != (i < 2 ? 0 : 1)) return rejected; }
+    const auto resources = object["resources"].toObject();
+    if (!exactKeys(resources, {"wallpaper"}) && !exactKeys(resources, {"wallpaper", "avatar"})) return rejected;
+    for (auto it = resources.begin(); it != resources.end(); ++it) {
+        if (!it.value().isObject()) return rejected;
+        const auto descriptor = it.value().toObject();
+        if (!exactKeys(descriptor, {"file", "sha256", "size"})
+            || descriptor["file"].toString() != it.key() + ".png"
+            || !QRegularExpression(QStringLiteral("\\A[0-9a-f]{64}\\z")).match(descriptor["sha256"].toString()).hasMatch()) return rejected;
+        const auto dimensions = descriptor["size"].toArray();
+        qint64 w, h;
+        if (dimensions.size() != 2 || !integer(dimensions[0], w) || !integer(dimensions[1], h)
+            || w <= 0 || h <= 0 || w > 8192 || h > 8192 || w * h > 16 * 1024 * 1024
+            || (it.key() == "avatar" && (w > 512 || h > 512))) return rejected;
+    }
+    const auto image = resources["wallpaper"].toObject();
+    if (!exactKeys(image, {"file", "sha256", "size"}) || image["file"].toString() != "wallpaper.png") return rejected;
+    const QString digest = image["sha256"].toString();
+    if (!QRegularExpression(QStringLiteral("\\A[0-9a-f]{64}\\z")).match(digest).hasMatch()) return rejected;
+    const auto size = image["size"].toArray();
+    qint64 width, height;
+    if (size.size() != 2 || !integer(size[0], width) || !integer(size[1], height)
+        || width <= 0 || height <= 0 || width > 8192 || height > 8192 || width * height > 16 * 1024 * 1024) return rejected;
+    Fd directory(openat(root.value, version.toUtf8().constData(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+    if (!trusted(directory.value, true)) return rejected;
+    if (resources.contains("avatar")) {
+        Fd avatar(openat(directory.value, "avatar.png", O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC));
+        if (!trusted(avatar.value, false, 16 * 1024 * 1024)) return rejected;
+        if (verifyBytes) {
+            const auto data = boundedRead(avatar.value, 16 * 1024 * 1024);
+            const auto descriptor = resources["avatar"].toObject();
+            if (QCryptographicHash::hash(data, QCryptographicHash::Sha256).toHex() != descriptor["sha256"].toString().toLatin1()
+                || data.size() < 24 || data.left(8) != QByteArray::fromHex("89504e470d0a1a0a") || data.mid(12, 4) != "IHDR"
+                || qFromBigEndian<quint32>(reinterpret_cast<const uchar *>(data.constData() + 16)) != descriptor["size"].toArray()[0].toInt()
+                || qFromBigEndian<quint32>(reinterpret_cast<const uchar *>(data.constData() + 20)) != descriptor["size"].toArray()[1].toInt()) return rejected;
+        }
+    }
+    Fd png(openat(directory.value, "wallpaper.png", O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC));
+    if (!trusted(png.value, false, 16 * 1024 * 1024)) return rejected;
+    if (verifyBytes) {
+        const auto bytes = boundedRead(png.value, 16 * 1024 * 1024);
+        if (QCryptographicHash::hash(bytes, QCryptographicHash::Sha256).toHex() != digest.toLatin1()
+            || bytes.size() < 24 || bytes.left(8) != QByteArray::fromHex("89504e470d0a1a0a")
+            || bytes.mid(12, 4) != "IHDR") return rejected;
+        const auto pngWidth = qFromBigEndian<quint32>(reinterpret_cast<const uchar *>(bytes.constData() + 16));
+        const auto pngHeight = qFromBigEndian<quint32>(reinterpret_cast<const uchar *>(bytes.constData() + 20));
+        if (pngWidth != width || pngHeight != height || lseek(png.value, 0, SEEK_SET) < 0) return rejected;
+        // Recheck the manifest after bytes are read so atomic replacement fails closed.
+        Fd current(openat(root.value, "manifest.json", O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC));
+        if (!trusted(current.value, false, 4096)
+            || QJsonDocument::fromJson(boundedRead(current.value, 4096)) != document) return rejected;
+    }
+    Result result{png.value, version, digest, fit == "fit" ? "contain" : "cover", QSize(int(width), int(height))};
+    png.value = -1;
+    return result;
+}
+}
