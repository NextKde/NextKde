+void WorkspaceScene::watchBootstrapPublication(uid_t uid, const QString &version, const QString &digest)
+{
+    delete m_bootstrapPublicationTimer;
+    m_bootstrapPublicationTimer = new QTimer(this);
+    m_bootstrapPublicationTimer->setInterval(500);
+    connect(m_bootstrapPublicationTimer, &QTimer::timeout, this, [this, uid, version, digest] {
+        if (!m_bootstrap) { m_bootstrapPublicationTimer->stop(); return; }
+        auto current = KosBootstrapPublication::openForUid(uid, false, 0);
+        const bool valid = current.fd >= 0 && current.version == version && current.digest == digest;
+        if (current.fd >= 0) { close(current.fd); }
+        if (!valid) {
+            KosHandoff::cancel();
+            QImage image(1, 1, QImage::Format_RGB32); image.fill(QColor("#16283b"));
+            m_bootstrap->setImage(image); m_bootstrapContain = false;
+            m_bootstrapPublicationTimer->stop(); addRepaintFull();
+            qInfo("KOS_DRM_HANDOFF BootstrapRevoked");
+        }
+    });
+    m_bootstrapPublicationTimer->start();
+}
+
+void WorkspaceScene::paintBootstrap(const RenderTarget &target, const RenderViewport &viewport, const Region &region)
+{
+    if (!m_bootstrap || region.isEmpty()) {
+        return;
+    }
+    // Per-output cover crop, prepared before the first scene frame.
+    const auto rect = viewport.renderRect();
+    const QSize imageSize = m_bootstrap->image().size();
+    const double scale = m_bootstrapContain
+        ? std::min(rect.width() / imageSize.width(), rect.height() / imageSize.height())
+        : std::max(rect.width() / imageSize.width(), rect.height() / imageSize.height());
+    const QSizeF scaled(imageSize.width() * scale, imageSize.height() * scale);
+    m_bootstrap->setSize(scaled);
+    m_bootstrap->setPosition(QPointF(rect.x() + (rect.width() - scaled.width()) / 2,
+                                  rect.y() + (rect.height() - scaled.height()) / 2));
+    m_renderer->renderItem(target, viewport, m_bootstrapRoot.get(), 0, region, WindowPaintData{},
+                           [](Item *) { return false; }, [](Item *) { return false; });
+}
