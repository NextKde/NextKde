+static QImage readBootstrapPng(int fd, QString *digest = nullptr)
+{
+    struct stat st{};
+    QFile input;
+    const bool virtualTest = qobject_cast<VirtualBackend *>(kwinApp()->outputBackend()) != nullptr;
+    if (fstat(fd, &st) != 0 || !S_ISREG(st.st_mode) || (st.st_uid != 0 && !(virtualTest && st.st_uid == 65534))
+        || (st.st_mode & 0022) || st.st_nlink != 1 || st.st_size <= 0 || st.st_size > 16 * 1024 * 1024
+        || (fcntl(fd, F_GETFL) & O_ACCMODE) != O_RDONLY
+        || !input.open(fd, QIODevice::ReadOnly, QFileDevice::AutoCloseHandle)) {
+        close(fd);
+        return {};
+    }
+    const QByteArray bytes = input.read(16 * 1024 * 1024 + 1);
+    if (bytes.size() > 16 * 1024 * 1024) { return {}; }
+    if (digest) { *digest = QString::fromLatin1(QCryptographicHash::hash(bytes, QCryptographicHash::Sha256).toHex()); }
+    QBuffer buffer; buffer.setData(bytes); buffer.open(QIODevice::ReadOnly);
+    QImageReader reader(&buffer, "png");
+    const QSize size = reader.size();
+    if (!size.isValid() || size.width() > 8192 || size.height() > 8192
+        || qint64(size.width()) * size.height() > 16 * 1024 * 1024) {
+        return {};
+    }
+    return reader.read().convertToFormat(QImage::Format_RGB32);
+}
