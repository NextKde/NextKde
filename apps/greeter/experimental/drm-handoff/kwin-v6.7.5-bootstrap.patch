+void KWinWrapper::startKWin()
+{
+    // Re-open each time: a withdrawn publication must not survive a crash restart.
+    if (m_bootstrapFd >= 0) { close(m_bootstrapFd); m_bootstrapFd = -1; }
+    QProcessEnvironment environment = QProcessEnvironment::systemEnvironment();
+    environment.remove(QStringLiteral("KOS_KWIN_BOOTSTRAP_FD"));
+    environment.remove(QStringLiteral("KOS_KWIN_HANDOFF_CONTROL_FD"));
+    environment.remove(QStringLiteral("KOS_KWIN_BOOTSTRAP_PNG"));
+    environment.remove(QStringLiteral("KOS_KWIN_BOOTSTRAP_PUBLIC_VERSION"));
+    environment.remove(QStringLiteral("KOS_KWIN_BOOTSTRAP_FIT"));
+    environment.remove(QStringLiteral("KOS_KWIN_BOOTSTRAP_DEFAULT"));
+    auto publication = KosBootstrapPublication::openForUid(getuid(), true, 30);
+    if (publication.fd >= 0) {
+        m_bootstrapFd = publication.fd;
+        environment.insert(QStringLiteral("KOS_KWIN_BOOTSTRAP_FD"), QString::number(m_bootstrapFd));
+        environment.insert(QStringLiteral("KOS_KWIN_BOOTSTRAP_FIT"), publication.fit);
+        environment.insert(QStringLiteral("KOS_KWIN_BOOTSTRAP_PUBLIC_VERSION"), publication.version);
+    }
+    if (m_bootstrapFd < 0) { environment.insert(QStringLiteral("KOS_KWIN_BOOTSTRAP_DEFAULT"), QStringLiteral("1")); }
+    const int fd = m_bootstrapFd;
+    m_kwinProcess->setChildProcessModifier([fd] {
+        if (fd >= 0) { fcntl(fd, F_SETFD, 0); }
+    });
+    m_kwinProcess->setProcessEnvironment(environment);
+    m_kwinProcess->start();
 }
 
