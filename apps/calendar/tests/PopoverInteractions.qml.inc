    TestCase {
        function verify(value, message) { if (!value) { console.error("REVIEW_VERIFY_FAILED", message || "", new Error().stack); fail(message || "Verification failed") } }
        function compare(actual, expected, message) { if (actual !== expected) { console.error("REVIEW_COMPARE_FAILED", actual, expected, new Error().stack); fail(message || "Comparison failed") } }
        function tryCompare(object, property, value, timeout) { const end = Date.now() + (timeout || 5000); while (object[property] !== value && Date.now() < end) wait(50); compare(object[property], value, property) }
        function tryVerify(callback, timeout) { const end = Date.now() + (timeout || 5000); while (!callback() && Date.now() < end) wait(50); verify(callback()) }

        id: uiTest
        name: "CalendarPopoverRange"
        windowShown: true
        when: pim.ready
        function test_zReminderOrganization() {
            eventEditor.close()
            taskEditor.close()
            root.switchWorkspace(true)
            root.searchQuery = ""
            const originalNow = remindersView.now
            remindersView.now = new Date(2026, 9, 29, 12)
            verify(remindersView.includes({due: "2026-10-28T12:00:00", completed: false}, "today", ""))
            verify(!remindersView.includes({due: "", completed: false}, "today", ""))
            verify(!remindersView.includes({due: "2026-10-28T12:00:00", completed: true}, "today", ""))
            compare(remindersView.priorityText({priority: 0}), "")
            compare(remindersView.priorityText({priority: 9}), "!")
            compare(remindersView.priorityText({priority: 5}), "!!")
            compare(remindersView.priorityText({priority: 1}), "!!!")
            remindersView.select("planned")
            compare(remindersView.sectionTitle({due: "2026-10-28"}), remindersView.sectionTitle({due: "2026-10-27"}))
            const eventCount = pim.events.length
            pim.createList({name: "Organization review", color: "#BF57DA"})
            tryVerify(() => pim.lists.some(list => list.name === "Organization review"))
            const list = pim.lists.find(list => list.name === "Organization review")
            remindersView.select("list", list.id)
            wait(100)
            const inlineAdd = findChild(remindersView, "inlineAdd_" + list.id + "_")
            const input = findChild(inlineAdd, "inlineReminderTitle")
            input.text = "Keep one reminder record"
            input.textEdited()
            inlineAdd.submit()
            tryVerify(() => pim.todos.some(todo => todo.title === "Keep one reminder record"))
            tryCompare(remindersView, "inlineSavingKey", "")
            compare(remindersView.inlineDrafts[list.id + "/"], undefined)
            const todo = pim.todos.find(todo => todo.title === "Keep one reminder record")
            compare(todo.listId, list.id)
            compare(todo.due, "")
            compare(pim.events.length, eventCount)
            taskEditor.openForTodo(todo)
            verify(findChild(taskEditor.contentItem, "reminderCategory") === null)
            compare(taskEditor.payload().listId, list.id)
            taskEditor.close()
            pim.updateTodo(todo.id, {due: "2026-10-29T00:00:00", allDay: true})
            tryVerify(() => pim.todos.find(item => item.id === todo.id).due.length > 0)
            compare(pim.events.length, eventCount)
            compare(root.categoryFor(pim.todos.find(item => item.id === todo.id)).color, "#BF57DA")
            remindersView.now = originalNow
            console.log("REMINDER_ORGANIZATION_TESTS_PASSED")
        }
        function test_creationAndRange() {
            root.viewIndex = 1
            wait(200)
            const grid = findChild(root.contentItem, "scheduleTimedGrid")
            verify(grid !== null)
            const x = 52 + (grid.width-52)/7*2.5
            mousePress(grid, x, 9*40+1)
            mouseMove(grid, x, 10*40-1, 80)
            mouseRelease(grid, x, 10*40-1)
            tryCompare(eventEditor, "visible", true)
            const draft = eventEditor.eventPayload()
            compare(draft.start.slice(11,16), "09:00")
            compare(draft.end.slice(11,16), "10:00")
            compare(eventEditor.modal, false)
            verify(eventEditor.anchorItem !== null)
            verify(eventEditor.anchorRect.height > 0)
            eventEditor.close()
            wait(100)
            mousePress(grid, x, 11*40-1)
            mouseMove(grid, x, 10*40+1, 80)
            mouseRelease(grid, x, 10*40+1)
            tryCompare(eventEditor, "visible", true)
            compare(eventEditor.eventPayload().start.slice(11,16), "10:00")
            compare(eventEditor.eventPayload().end.slice(11,16), "11:00")
            eventEditor.close()
            mouseClick(addButton)
            tryCompare(eventEditor, "visible", true)
            compare(eventEditor.modal, false)
            eventEditor.setQuickTitle("Draft preserved")
            eventEditor.switchTypeRequested()
            verify(taskEditor.visible)
            compare(taskEditor.payload().title, "Draft preserved")
            taskEditor.switchTypeRequested()
            verify(eventEditor.visible)
            compare(eventEditor.eventPayload().title, "Draft preserved")
            eventEditor.accept()
            tryVerify(function() { return pim.events.length === 1 })
            tryCompare(eventEditor, "visible", false)
            const record = pim.events[0]
            itemDetails.showItem({kind: "event", record: record}, addButton)
            compare(itemDetails.modal, false)
            verify(itemDetails.visible)
            itemDetails.editRequested()
            itemDetails.close()
            verify(eventEditor.visible)
            compare(eventEditor.editingId, record.id)
            eventEditor.setQuickTitle("Updated through popover")
            eventEditor.accept()
            tryVerify(function() { return pim.events[0].title === "Updated through popover" })
            // One window, one PIM client: undated reminders, list assignment,
            // details/edit, completion and mode switching share the same record.
            root.switchWorkspace(true)
            compare(root.remindersMode, true)
            pim.createList({name: "Integration list"})
            tryVerify(function() { return pim.lists.some(list => list.name === "Integration list") })
            const list = pim.lists.find(list => list.name === "Integration list")
            remindersView.select("list", list.id)
            root.openNewReminder(addButton)
            taskEditor.setQuickTitle("Undated integration reminder")
            compare(taskEditor.payload().due, "")
            compare(taskEditor.payload().listId, list.id)
            compare(taskEditor.modal, false)
            taskEditor.accept()
            tryVerify(function() { return pim.todos.length === 1 })
            tryCompare(taskEditor, "visible", false)
            compare(remindersView.visibleTodos.length, 1)
            const todo = pim.todos[0]
            root.switchWorkspace(false)
            compare(root.viewIndex, 1)
            root.switchWorkspace(true)
            compare(remindersView.listId, list.id)
            itemDetails.showItem({kind: "todo", record: todo}, addButton)
            verify(itemDetails.visible)
            itemDetails.editRequested()
            itemDetails.close()
            compare(taskEditor.editingId, todo.id)
            taskEditor.setQuickTitle("Updated reminder")
            taskEditor.accept()
            tryVerify(function() { return pim.todos[0].title === "Updated reminder" })
            tryCompare(taskEditor, "visible", false)
            root.searchQuery = "missing title"
            compare(remindersView.visibleTodos.length, 0)
            root.searchQuery = "updated"
            compare(remindersView.visibleTodos.length, 1)
            root.searchQuery = ""
            pim.updateTodo(todo.id, {completed: true})
            tryVerify(function() { return pim.todos[0].completed })
            compare(remindersView.visibleTodos.length, 0)
            remindersView.select("completed")
            compare(remindersView.visibleTodos.length, 1)
            pim.updateTodo(todo.id, {completed: false})
            tryVerify(function() { return !pim.todos[0].completed })
            remindersView.select("all")
            compare(remindersView.visibleTodos.length, 1)
            reminderListEditor.edit(list, addButton, list.name)
            findChild(reminderListEditor.contentItem, "reminderListName").text = "Renamed list"
            reminderListEditor.accept()
            tryVerify(function() { return pim.lists.some(item => item.id === list.id && item.name === "Renamed list") })
            tryCompare(reminderListEditor, "visible", false)
            pim.removeList(list.id)
            tryVerify(function() { return !pim.lists.some(item => item.id === list.id) })
            compare(pim.todos.length, 1)
            compare(pim.todos[0].listId, "inbox")
            root.handleActivation(["--view", "reminders", "--item", todo.id], "")
            tryCompare(itemDetails, "visible", true)
            verify(root.remindersMode)
            itemDetails.close()
            taskEditor.openForTodo({id: "custom-rule-probe", title: "Imported rule", due: "2026-11-01T09:00:00", recurrence: "custom"})
            verify(!("recurrence" in taskEditor.payload()))
            taskEditor.close()
            taskEditor.anchorItem = addButton
            taskEditor.openForTodo(pim.todos[0])
            findChild(taskEditor.contentItem, "reminderRecurrence").currentIndex = 2
            taskEditor.accept()
            verify(taskEditor.visible)
            verify(taskEditor.errorFields.includes("dueDate"))
            compare(pim.todos[0].due, "")
            findChild(taskEditor.contentItem, "reminderDueDate").text = "2026-11-01"
            taskEditor.accept()
            tryVerify(function() { return pim.todos[0].recurrence === "weekly" })
            tryCompare(taskEditor, "visible", false)
            compare(pim.todos[0].due.slice(0,10), "2026-11-01")
            remindersView.select("planned")
            compare(remindersView.visibleTodos.length, 1)
            // Searching and then opening a result must not destroy its anchor.
            toolbarSearch.open()
            root.searchQuery = "updated"
            wait(250)
            const reminderList = findChild(root.contentItem, "remindersList")
            const resultRow = findChild(reminderList, "reminderDetails_" + pim.todos[0].id)
            verify(resultRow !== null)
            mouseClick(resultRow, resultRow.width / 2, resultRow.height / 2)
            tryCompare(taskEditor, "visible", true)
            wait(150)
            verify(taskEditor.visible)
            compare(root.searchQuery, "updated")
            taskEditor.close()
            toolbarSearch.close()
            root.width = 760
            root.height = 540
            wait(100)
            verify(remindersView.width > 400)
            verify(remindersView.height > 400)
            root.switchWorkspace(false)
            compare(root.viewIndex, 1)
            root.sidebarExpanded = false
            wait(300)
            const collapsedSwitch = findChild(root.contentItem, "collapsedWorkspaceSwitch")
            const granularity = findChild(root.contentItem, "toolbarViewSegment")
            verify(collapsedSwitch.visible)
            verify(collapsedSwitch.x + collapsedSwitch.width <= granularity.x)
            root.searchQuery = "calendar query"
            root.switchWorkspace(true)
            root.searchQuery = "reminder query"
            root.switchWorkspace(false)
            compare(root.searchQuery, "calendar query")
            root.switchWorkspace(true)
            compare(root.searchQuery, "reminder query")
            remindersView.select("today")
            root.openNewReminder(addButton)
            compare(taskEditor.payload().due.slice(0,10), root.dateKey(root.now))
            taskEditor.close()
            remindersView.select("completed")
            root.openNewReminder(addButton)
            compare(remindersView.filter, "all")
            taskEditor.close()
            root.handleActivation(["--item", "event:" + record.id], "")
            tryCompare(root, "remindersMode", false)
            tryCompare(itemDetails, "visible", true)
            compare(itemDetails.itemTitle, "Updated through popover")
            itemDetails.close()
            root.handleActivation(["--view", "reminders", "--item", todo.id], "")
            tryCompare(root, "remindersMode", true)
            tryCompare(itemDetails, "visible", true)
            compare(remindersView.listId, "inbox")
            compare(itemDetails.itemTitle, "Updated reminder")
            verify(itemDetails.anchorItem !== addButton)
            itemDetails.close()
            console.log("POPOVER_RANGE_TESTS_PASSED")
        }
    }

    Timer { interval: 1200; running: true; onTriggered: uiTest.qtest_run() }
