    TestCase {
        function verify(value, message) { if (!value) { console.error("REVIEW_VERIFY_FAILED", message || "", new Error().stack); fail(message || "Verification failed") } }
        function compare(actual, expected, message) { if (actual !== expected) { console.error("REVIEW_COMPARE_FAILED", actual, expected, new Error().stack); fail(message || "Comparison failed") } }
        function tryCompare(object, property, value, timeout) { const end = Date.now() + (timeout || 5000); while (object[property] !== value && Date.now() < end) wait(50); compare(object[property], value, property) }
        function tryVerify(callback, timeout) { const end = Date.now() + (timeout || 5000); while (!callback() && Date.now() < end) wait(50); verify(callback()) }

        id: organizationTest
        name: "ReminderOrganization"
        windowShown: true
        when: pim.ready
        function test_organization() {
            root.switchWorkspace(true)
            pim.createList({name: "工作", color: "#BF57DA"})
            tryVerify(() => pim.lists.some(list => list.name === "工作"))
            const list = pim.lists.find(list => list.name === "工作")
            remindersView.select("list", list.id)
            pim.createTodo({title: "准备项目发布", listId: list.id, flagged: true})
            tryVerify(() => pim.todos.length === 1)
            const parent = JSON.parse(JSON.stringify(pim.todos[0]))
            pim.createTodo({title: "整理发布说明", parentId: parent.id, allDay: true})
            tryVerify(() => pim.todos.length === 2)
            compare(remindersView.visibleTodos.length, 2)
            compare(remindersView.visibleTodos[1].displayDepth, 1)
            remindersView.toggleChildren(parent.id)
            compare(remindersView.visibleTodos.length, 1)
            compare(remindersView.count("list", list.id), 2)
            remindersView.toggleChildren(parent.id)
            compare(remindersView.visibleTodos.length, 2)
            remindersView.select("flagged")
            compare(remindersView.visibleTodos.length, 1)
            compare(remindersView.visibleTodos[0].id, parent.id)
            pim.updateTodo(parent.id, {flagged: false})
            tryVerify(() => remindersView.visibleTodos.length === 0)
            remindersView.select("list", list.id)
            taskEditor.openForTodo(pim.todos.find(todo => todo.parentId === parent.id))
            compare(taskEditor.parentTitle, "准备项目发布")
            compare(taskEditor.payload().listId, list.id)
            taskEditor.close()
            const inlineAdd = findChild(remindersView, "inlineAdd_" + list.id + "_")
            const quick = findChild(inlineAdd, "inlineReminderTitle")
            quick.text = "检查交付清单"
            quick.textEdited()
            inlineAdd.submit()
            tryVerify(() => pim.todos.length === 3)
            tryCompare(remindersView, "inlineSavingKey", "")
            compare(remindersView.inlineDrafts[list.id + "/"], undefined)
            wait(500)
            const view = findChild(remindersView, "remindersList")
            verify(findChild(view, "reminderRow_" + parent.id) !== null)
            grabImage(root.contentItem).save("/tmp/calendar-reminder-organization.png")
            pim.updateTodo(parent.id, {tags: ["release", "work"], section: "准备", order: 100})
            tryVerify(() => pim.todos.find(todo => todo.id === parent.id).tags.length === 2)
            remindersView.select("tag", "release")
            compare(remindersView.visibleTodos.length, 1)
            pim.saveGroup("", {name: "项目"})
            tryVerify(() => pim.groups.some(group => group.name === "项目"))
            reminderListEditor.edit(null, addButton, "")
            findChild(reminderListEditor.contentItem, "reminderListName").text = "发布跟进"
            findChild(reminderListEditor.contentItem, "listGroup").currentIndex = 1
            findChild(reminderListEditor.contentItem, "listKind").currentIndex = 1
            findChild(reminderListEditor.contentItem, "smartTag").text = "release"
            wait(200)
            verify(reminderListEditor.height <= root.contentItem.height)
            grabImage(root.contentItem).save("/tmp/calendar-smart-list-editor.png")
            reminderListEditor.accept()
            tryVerify(() => pim.lists.some(item => item.name === "发布跟进"))
            tryCompare(reminderListEditor, "visible", false)
            const smart = pim.lists.find(item => item.name === "发布跟进")
            compare(smart.kind, "smart")
            compare(smart.group, "项目")
            remindersView.select("smart", smart.id)
            compare(remindersView.visibleTodos.length, 1)
            compare(remindersView.creationDefaults().tags[0], "release")
            pim.updateList(list.id, {group: "项目"})
            tryVerify(() => pim.lists.find(item => item.id === list.id).group === "项目")
            remindersView.select("list", list.id)
            const third = JSON.parse(JSON.stringify(pim.todos.find(todo => todo.title === "检查交付清单")))
            verify(remindersView.moveRelative(third.id, pim.todos.find(todo => todo.id === parent.id), false))
            wait(300)
            tryVerify(() => pim.todos.find(todo => todo.id === third.id).order < 100)
            compare(pim.todos.find(todo => todo.id === third.id).section, "准备")
            wait(300)
            // Exercise a real drag, not only the ordering helper.
            mouseMove(findChild(remindersView, "reminderRow_" + third.id), 10, 10)
            wait(100)
            const from = findChild(remindersView, "reminderDrag_" + third.id)
            const to = findChild(remindersView, "reminderRow_" + parent.id)
            verify(from !== null && to !== null)
            const destination = to.mapToItem(root.contentItem, 20, to.height - 3)
            mousePress(from, from.width / 2, from.height / 2)
            mouseMove(from, from.width / 2 + 15, from.height / 2, 80)
            mouseMove(root.contentItem, destination.x, destination.y, 250)
            mouseRelease(root.contentItem, destination.x, destination.y)
            tryVerify(() => pim.todos.find(todo => todo.id === third.id).order > 100)
            wait(300)
            mouseMove(findChild(remindersView, "reminderRow_" + third.id), 10, 10)
            wait(100)
            const moveHandle = findChild(remindersView, "reminderDrag_" + third.id)
            const inboxTarget = findChild(root.contentItem, "reminderListTarget_inbox")
            verify(moveHandle !== null && inboxTarget !== null)
            const inboxPoint = inboxTarget.mapToItem(root.contentItem, inboxTarget.width / 2, inboxTarget.height / 2)
            mousePress(moveHandle, moveHandle.width / 2, moveHandle.height / 2)
            mouseMove(moveHandle, moveHandle.width / 2 + 15, moveHandle.height / 2, 80)
            mouseMove(root.contentItem, inboxPoint.x, inboxPoint.y, 250)
            mouseRelease(root.contentItem, inboxPoint.x, inboxPoint.y)
            tryVerify(() => pim.todos.find(todo => todo.id === third.id).listId === "inbox")
            compare(pim.todos.length, 3)
            wait(300)
            grabImage(root.contentItem).save("/tmp/calendar-reminder-organized.png")
            AppTheme.appearanceMode = "dark"
            Demo.AppTheme.appearanceMode = "dark"
            wait(300)
            grabImage(root.contentItem).save("/tmp/calendar-reminder-organized-dark.png")
            reminderListEditor.edit(smart, addButton, smart.name)
            wait(300)
            grabImage(root.contentItem).save("/tmp/calendar-smart-list-dark.png")
            reminderListEditor.close()
            console.log("REMINDER_ORGANIZATION_TESTS_PASSED")
        }
    }
    Timer { interval: 1200; running: true; onTriggered: organizationTest.qtest_run() }
