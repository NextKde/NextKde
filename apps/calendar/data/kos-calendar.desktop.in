[Desktop Entry]
Version=1.0
Type=Application
Name=KOS Calendar
Name[zh]=KOS 日历
Name[zh_CN]=KOS 日历
Name[pt]=Calendário KOS
Name[pt_BR]=Calendário KOS
GenericName=Calendar
GenericName[zh]=日历
GenericName[zh_CN]=日历
GenericName[pt]=Calendário
GenericName[pt_BR]=Calendário
Comment=Plan events and keep calendar-linked tasks in sync
Comment[zh]=安排日程并同步日历关联任务
Comment[zh_CN]=安排日程并同步日历关联任务
Comment[pt]=Planeje eventos e mantenha sincronizadas as tarefas vinculadas ao calendário
Comment[pt_BR]=Planeje eventos e mantenha sincronizadas as tarefas vinculadas ao calendário
TryExec=@KOS_APP_EXECUTABLE@
Exec=@KOS_APP_EXECUTABLE@
Icon=kos-calendar
Terminal=false
Categories=Office;Calendar;Qt;
Keywords=calendar;event;schedule;todo;
Keywords[pt]=calendário;evento;agenda;tarefa;
Keywords[pt_BR]=calendário;evento;agenda;tarefa;
StartupNotify=true
StartupWMClass=kos-calendar
X-GNOME-SingleWindow=true
Actions=Today;Settings;

[Desktop Action Today]
Name=Today
Name[zh]=今天
Name[zh_CN]=今天
Name[pt]=Hoje
Name[pt_BR]=Hoje
Exec=@KOS_APP_EXECUTABLE@ --date today

[Desktop Action Settings]
Name=Settings
Name[zh]=设置
Name[zh_CN]=设置
Name[pt]=Configurações
Name[pt_BR]=Configurações
Exec=@KOS_APP_EXECUTABLE@ --settings
