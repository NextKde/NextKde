[Desktop Entry]
Version=1.0
Type=Application
Name=KOS Calendar
Name[zh]=KOS 日历
Name[zh_CN]=KOS 日历
Name[pt]=Calendário KOS
Name[pt_BR]=Calendário KOS
GenericName=Calendar
GenericName[zh]=日历
GenericName[zh_CN]=日历
GenericName[pt]=Calendário
GenericName[pt_BR]=Calendário
Comment=Plan events and manage reminders in one window
Comment[zh]=在同一窗口安排日程与管理提醒事项
Comment[zh_CN]=在同一窗口安排日程与管理提醒事项
Comment[pt]=Planeje eventos e gerencie lembretes em uma única janela
Comment[pt_BR]=Planeje eventos e gerencie lembretes em uma única janela
TryExec=@KOS_APP_EXECUTABLE@
Exec=@KOS_APP_EXECUTABLE@
Icon=kos-calendar
Terminal=false
Categories=Office;Calendar;Qt;
Keywords=calendar;event;schedule;todo;reminder;task;
Keywords[zh_CN]=日历;提醒事项;待办;任务;日程;
Keywords[pt]=calendário;evento;agenda;tarefa;lembrete;
Keywords[pt_BR]=calendário;evento;agenda;tarefa;lembrete;
StartupNotify=true
StartupWMClass=kos-calendar
X-GNOME-SingleWindow=true
Actions=Today;Reminders;Settings;

[Desktop Action Today]
Name=Today
Name[zh]=今天
Name[zh_CN]=今天
Name[pt]=Hoje
Name[pt_BR]=Hoje
Exec=@KOS_APP_EXECUTABLE@ --date today

[Desktop Action Settings]
Name=Settings
Name[zh]=设置
Name[zh_CN]=设置
Name[pt]=Configurações
Name[pt_BR]=Configurações
Exec=@KOS_APP_EXECUTABLE@ --settings

[Desktop Action Reminders]
Name=Reminders
Name[zh]=提醒事项
Name[zh_CN]=提醒事项
Exec=@KOS_APP_EXECUTABLE@ --view reminders
