[Desktop Entry]
Version=1.0
Type=Application
Name=KOS Weather
Name[zh]=KOS 天气
Name[zh_CN]=KOS 天气
Name[pt]=KOS Clima
Name[pt_BR]=KOS Clima
GenericName=Weather
GenericName[zh]=天气
GenericName[zh_CN]=天气
GenericName[pt]=Clima
GenericName[pt_BR]=Clima
Comment=View current conditions and forecasts for saved locations
Comment[zh]=查看已保存地点的实时天气与预报
Comment[zh_CN]=查看已保存地点的实时天气与预报
Comment[pt]=Veja as condições atuais e a previsão do tempo dos locais salvos
Comment[pt_BR]=Veja as condições atuais e a previsão do tempo dos locais salvos
TryExec=@KOS_APP_EXECUTABLE@
Exec=@KOS_APP_EXECUTABLE@
Icon=kos-weather
Terminal=false
Categories=Utility;Qt;
Keywords=weather;forecast;temperature;
Keywords[pt]=clima;tempo;previsão;temperatura;
Keywords[pt_BR]=clima;tempo;previsão;temperatura;
StartupNotify=true
StartupWMClass=kos-weather
X-GNOME-SingleWindow=true
Actions=Settings;

[Desktop Action Settings]
Name=Settings
Name[zh]=设置
