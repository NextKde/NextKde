{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "KOS Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "KOS_BUILD_KWIN_PLUGINS": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "KOS Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "KOS_BUILD_KWIN_PLUGINS": "ON"
      }
    },
    {
      "name": "apps-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "KOS_BUILD_PLATFORM": "OFF",
        "KOS_BUILD_KWIN_PLUGINS": "OFF",
        "KOS_BUILD_CALENDAR": "ON",
        "KOS_BUILD_CALCULATOR": "ON",
        "KOS_BUILD_TODO": "ON",
        "KOS_BUILD_WEATHER": "ON",
        "KOS_BUILD_LISTENFREE": "OFF"
      }
    },
    {
      "name": "apps-dev",
      "displayName": "Calendar with Reminders, Calculator and Weather (development)",
      "inherits": "apps-base",
      "binaryDir": "${sourceDir}/.build/apps-dev"
    },
    {
      "name": "apps-release",
      "displayName": "Calendar with Reminders, Calculator and Weather (release install)",
      "inherits": "apps-base",
      "binaryDir": "${sourceDir}/.build/apps-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "$env{HOME}/.local"
      }
    },
    {
      "name": "calendar-dev",
      "displayName": "Calendar only",
      "inherits": "apps-base",
      "binaryDir": "${sourceDir}/.build/calendar-dev",
      "cacheVariables": {
        "KOS_BUILD_CALENDAR": "ON",
        "KOS_BUILD_CALCULATOR": "OFF",
        "KOS_BUILD_TODO": "OFF",
        "KOS_BUILD_WEATHER": "OFF",
        "KOS_BUILD_LISTENFREE": "OFF"
      }
    },
    {
      "name": "todo-dev",
      "displayName": "Calendar with legacy Todo launcher",
      "inherits": "apps-base",
      "binaryDir": "${sourceDir}/.build/todo-dev",
      "cacheVariables": {
        "KOS_BUILD_CALENDAR": "OFF",
        "KOS_BUILD_CALCULATOR": "OFF",
        "KOS_BUILD_TODO": "ON",
        "KOS_BUILD_WEATHER": "OFF",
        "KOS_BUILD_LISTENFREE": "OFF"
      }
    },
    {
      "name": "weather-dev",
      "displayName": "Weather only",
      "inherits": "apps-base",
      "binaryDir": "${sourceDir}/.build/weather-dev",
      "cacheVariables": {
        "KOS_BUILD_CALENDAR": "OFF",
        "KOS_BUILD_CALCULATOR": "OFF",
        "KOS_BUILD_TODO": "OFF",
        "KOS_BUILD_WEATHER": "ON",
        "KOS_BUILD_LISTENFREE": "OFF"
      }
    },
    {
      "name": "listenfree-dev",
      "displayName": "KOS ListenFree only",
      "inherits": "apps-base",
      "binaryDir": "${sourceDir}/.build/listenfree-dev",
      "cacheVariables": {
        "KOS_BUILD_CALENDAR": "OFF",
        "KOS_BUILD_CALCULATOR": "OFF",
        "KOS_BUILD_TODO": "OFF",
        "KOS_BUILD_WEATHER": "OFF",
        "KOS_BUILD_LISTENFREE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "apps-dev", "configurePreset": "apps-dev" },
    { "name": "apps-release", "configurePreset": "apps-release" },
    { "name": "calendar-dev", "configurePreset": "calendar-dev" },
    { "name": "todo-dev", "configurePreset": "todo-dev" },
    { "name": "weather-dev", "configurePreset": "weather-dev" },
    { "name": "listenfree-dev", "configurePreset": "listenfree-dev" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "apps-dev", "configurePreset": "apps-dev", "output": { "outputOnFailure": true } },
    { "name": "apps-release", "configurePreset": "apps-release", "output": { "outputOnFailure": true } }
  ]
}
